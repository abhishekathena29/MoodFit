rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user owns exactly one profile doc (name, fashion
    // profile, onboarding status, streak, xp, daily nudge) plus private
    // subcollections: outfit logs and Muse chat messages.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // App-wide settings managed from the Firebase console (e.g. config/ai
    // holds the Groq model + API key). Readable by signed-in users only;
    // never writable from the client.
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
