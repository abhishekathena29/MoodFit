rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user owns exactly one profile doc (name, onboarding
    // status, streak, xp) plus a private subcollection of outfit logs.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /logs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
